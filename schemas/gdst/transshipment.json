{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#GDSTTransshipmentEvent&1.0.0",
  "title": "GDST Transshipment Event (CTE)",
  "description": "Source Pydantic: api/app/models/gdst/transshipment.py::TransshipmentEvent. Rules: GDST_COMMON_001-004, GDST_TRANSSHIP_001-002.",
  "type": "object",
  "required": ["gdst_event_type", "what", "when", "where", "iuu", "transshipment_vessel"],
  "properties": {
    "gdst_event_type": { "const": "Transshipment" },
    "who": {
      "type": "object",
      "properties": {
        "product_owner": { "type": "string" },
        "information_provider": { "type": "string" }
      }
    },
    "what": {
      "type": "object",
      "required": ["species", "quantity", "unit_of_measure"],
      "properties": {
        "species": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "quantity": { "type": "number", "exclusiveMinimum": 0 },
        "unit_of_measure": { "type": "string", "enum": ["KGM", "TNE", "LBR", "EA"] },
        "linking_kde": { "type": "string" }
      }
    },
    "where": {
      "type": "object",
      "properties": {
        "event_read_point": {
          "type": "object",
          "properties": {
            "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
            "longitude": { "type": "number", "minimum": -180, "maximum": 180 }
          }
        }
      }
    },
    "when": {
      "type": "object",
      "required": ["event_id", "event_datetime"],
      "properties": {
        "event_id": { "type": "string", "minLength": 6, "maxLength": 64 },
        "event_datetime": { "type": "string", "format": "date-time" }
      }
    },
    "iuu": {
      "type": "object",
      "required": ["transshipment_authorization"],
      "properties": {
        "transshipment_authorization": { "type": "string", "minLength": 1 }
      }
    },
    "transshipment_vessel": {
      "type": "object",
      "anyOf": [
        { "required": ["vessel_id"] },
        { "required": ["vessel_name"] }
      ],
      "properties": {
        "vessel_id": { "type": "string" },
        "vessel_name": { "type": "string" },
        "vessel_registration": { "type": "string" },
        "vessel_flag": { "type": "string", "pattern": "^[A-Z]{2}$" }
      }
    }
  }
}
