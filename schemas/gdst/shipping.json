{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#GDSTShippingEvent&1.0.0",
  "title": "GDST Shipping Event (CTE)",
  "description": "Source Pydantic: api/app/models/gdst/shipping.py::ShippingReceivingEvent (mapped to 'Shipping' at the VC boundary). Rules: GDST_COMMON_001-004, GDST_SHIPPING_001-002.",
  "type": "object",
  "required": ["gdst_event_type", "what", "when", "where"],
  "properties": {
    "gdst_event_type": { "enum": ["Shipping", "ShippingReceiving"] },
    "who": {
      "type": "object",
      "properties": {
        "product_owner": { "type": "string" },
        "information_provider": { "type": "string" }
      }
    },
    "what": {
      "type": "object",
      "required": ["species", "quantity", "unit_of_measure", "linking_kde"],
      "properties": {
        "species": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "quantity": { "type": "number", "exclusiveMinimum": 0 },
        "unit_of_measure": { "type": "string", "enum": ["KGM", "TNE", "LBR", "EA"] },
        "linking_kde": { "type": "string", "minLength": 1 },
        "item_sku_upc_gtin": { "type": "string" }
      }
    },
    "where": {
      "type": "object",
      "anyOf": [
        { "required": ["source_location"] },
        { "required": ["destination_location"] }
      ],
      "properties": {
        "source_location": { "type": "string" },
        "destination_location": { "type": "string" }
      }
    },
    "when": {
      "type": "object",
      "required": ["event_id", "event_datetime"],
      "properties": {
        "event_id": { "type": "string", "minLength": 6, "maxLength": 64 },
        "event_datetime": { "type": "string", "format": "date-time" }
      }
    },
    "iuu": {
      "type": "object",
      "properties": {
        "chain_of_custody_certification": { "type": "string" }
      }
    }
  }
}
