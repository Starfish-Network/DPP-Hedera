{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#GDSTOnVesselProcessingEvent&1.0.0",
  "title": "GDST On-Vessel Processing Event (CTE)",
  "description": "Source Pydantic: api/app/models/gdst/on_vessel.py::OnVesselProcessingEvent. Rules: GDST_COMMON_001-004, GDST_ONVESSEL_001.",
  "type": "object",
  "required": ["gdst_event_type", "what", "when", "where"],
  "properties": {
    "gdst_event_type": { "const": "OnVesselProcessing" },
    "who": {
      "type": "object",
      "properties": {
        "product_owner": { "type": "string" },
        "information_provider": { "type": "string" }
      }
    },
    "what": {
      "type": "object",
      "required": ["species", "quantity", "unit_of_measure"],
      "properties": {
        "species": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "quantity": { "type": "number", "exclusiveMinimum": 0 },
        "unit_of_measure": { "type": "string", "enum": ["KGM", "TNE", "LBR", "EA"] },
        "product_form": { "type": "string" }
      }
    },
    "where": {
      "type": "object",
      "properties": {
        "event_read_point": {
          "type": "object",
          "properties": {
            "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
            "longitude": { "type": "number", "minimum": -180, "maximum": 180 }
          }
        }
      }
    },
    "when": {
      "type": "object",
      "required": ["event_id", "event_datetime", "production_date"],
      "properties": {
        "event_id": { "type": "string", "minLength": 6, "maxLength": 64 },
        "event_datetime": { "type": "string", "format": "date-time" },
        "production_date": { "type": "string", "format": "date-time" }
      }
    },
    "iuu": {
      "type": "object",
      "properties": {
        "production_method": { "type": "string" },
        "chain_of_custody_certification": { "type": "string" }
      }
    },
    "vessel": {
      "type": "object",
      "properties": {
        "vessel_id": { "type": "string" },
        "vessel_name": { "type": "string" }
      }
    }
  }
}
