{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#FSMA204TransformingEvent&1.0.0",
  "title": "FSMA 204 Transforming Event",
  "description": "Source Pydantic: api/app/models/starfish_events.py::TransformingEvent. Rules: FSMA_COMMON_001, FSMA_TRANSFORMING_001-003.",
  "type": "object",
  "required": ["eventType", "event_time", "facility", "input_items", "output_items"],
  "properties": {
    "eventType": { "const": "transforming" },
    "event_time": { "type": "string", "format": "date-time" },
    "event_timezone_offset": { "type": "string", "pattern": "^[+-]\\d{2}:\\d{2}$" },
    "facility": { "type": "string", "minLength": 1 },
    "transformation_id": { "type": "string" },
    "input_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["epc", "quantity", "unit_of_measurement"],
        "properties": {
          "epc": { "type": "string", "minLength": 1 },
          "quantity": { "type": "number" },
          "unit_of_measurement": { "type": "string", "minLength": 1 }
        }
      }
    },
    "output_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["epc", "quantity", "unit_of_measurement"],
        "properties": {
          "epc": { "type": "string", "minLength": 1 },
          "quantity": { "type": "number" },
          "unit_of_measurement": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
