{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#FSMA204ShippingEvent&1.0.0",
  "title": "FSMA 204 Shipping Event",
  "description": "Source Pydantic: api/app/models/starfish_events.py::ShippingEvent. Rules: FSMA_COMMON_001, FSMA_SHIPPING_001-003.",
  "type": "object",
  "required": ["eventType", "event_time", "ship_from", "ship_to", "items"],
  "properties": {
    "eventType": { "const": "shipping" },
    "event_time": { "type": "string", "format": "date-time" },
    "event_timezone_offset": { "type": "string", "pattern": "^[+-]\\d{2}:\\d{2}$" },
    "ship_from": { "type": "string", "minLength": 1 },
    "ship_to": { "type": "string", "minLength": 1 },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["epc", "quantity", "unit_of_measurement"],
        "properties": {
          "epc": { "type": "string", "minLength": 1 },
          "quantity": { "type": "number" },
          "unit_of_measurement": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
