{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#FSMA204CreatingEvent&1.0.0",
  "title": "FSMA 204 Creating Event",
  "description": "Source Pydantic: api/app/models/starfish_events.py::CreatingEvent. Rules: FSMA_COMMON_001, FSMA_CREATING_001-002.",
  "type": "object",
  "required": ["eventType", "event_time", "biz_location", "quantity_list"],
  "properties": {
    "eventType": { "const": "creating" },
    "event_time": { "type": "string", "format": "date-time" },
    "event_timezone_offset": { "type": "string", "pattern": "^[+-]\\d{2}:\\d{2}$" },
    "biz_location": { "type": "string", "minLength": 1 },
    "quantity_list": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["epc", "quantity", "unit_of_measurement"],
        "properties": {
          "epc": { "type": "string", "minLength": 1 },
          "quantity": { "type": "number" },
          "unit_of_measurement": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
