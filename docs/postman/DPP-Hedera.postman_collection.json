{
	"info": {
		"_postman_id": "a6a1b5a0-8f2e-4d2a-bd7a-111111111111",
		"name": "DPP-Hedera API",
		"description": "Traceability API for the DPP-Hedera project (FastAPI, mounted at `/api/v1`).\n\nConfigure the `baseUrl` collection variable (default `http://localhost:8000/api/v1`). After calling `Login`, the returned `access_token` is stored on the collection as `token` and used as a Bearer token by the other requests.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{ "key": "token", "value": "{{token}}", "type": "string" }
		]
	},
	"item": [
		{
			"name": "Root",
			"item": [
				{
					"name": "Health",
					"request": {
						"method": "GET",
						"header": [],
						"url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
					}
				},
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const json = pm.response.json();",
									"if (json.access_token) {",
									"    pm.collectionVariables.set('token', json.access_token);",
									"}"
								]
							}
						}
					],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/login?username={{username}}&role={{role}}",
							"host": ["{{baseUrl}}"],
							"path": ["login"],
							"query": [
								{ "key": "username", "value": "{{username}}" },
								{ "key": "role", "value": "{{role}}" }
							]
						},
						"description": "Returns a JWT. Token is saved to the `token` collection variable for subsequent requests."
					}
				}
			]
		},
		{
			"name": "Guardian",
			"item": [
				{
					"name": "Health",
					"request": {
						"method": "GET",
						"header": [],
						"url": { "raw": "{{baseUrl}}/guardian/health", "host": ["{{baseUrl}}"], "path": ["guardian", "health"] }
					}
				},
				{
					"name": "Register operator",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"operator-demo\",\n  \"password\": \"Sup3rSecret!\",\n  \"acknowledged_vc_disclosure\": true,\n  \"consent_recorded_at\": \"2026-04-21T10:00:00Z\",\n  \"role\": \"User\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/guardian/register", "host": ["{{baseUrl}}"], "path": ["guardian", "register"] },
						"description": "FR-015: `acknowledged_vc_disclosure` must be `true` and a `consent_recorded_at` timestamp must be supplied."
					}
				},
				{
					"name": "Resolve DID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/guardian/did/{{username}}",
							"host": ["{{baseUrl}}"],
							"path": ["guardian", "did", "{{username}}"]
						}
					}
				}
			]
		},
