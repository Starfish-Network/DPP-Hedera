{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dpp.starfish.network/schemas/vc-output.schema.json",
  "title": "DPP-Hedera Compliance VC — output contract",
  "description": "Shape guarantees made by our Guardian policies to downstream consumers. Any policy we publish under FR-004 MUST produce VCs that validate against the matching oneOf branch.",
  "oneOf": [
    { "$ref": "#/$defs/GDSTComplianceCredential" },
    { "$ref": "#/$defs/FSMA204ComplianceCredential" }
  ],
  "$defs": {
    "BaseVC": {
      "type": "object",
      "required": ["@context", "type", "issuer", "issuanceDate", "credentialSubject", "proof"],
      "properties": {
        "@context": {
          "type": "array",
          "contains": { "const": "https://www.w3.org/2018/credentials/v1" }
        },
        "type": {
          "type": "array",
          "contains": { "const": "VerifiableCredential" },
          "minItems": 2
        },
        "issuer": {
          "type": "string",
          "pattern": "^did:hedera:(testnet|mainnet):.+_0\\.0\\.[0-9]+$",
          "description": "Standard Registry DID; the trust anchor (Constitution §II)."
        },
        "issuanceDate": { "type": "string", "format": "date-time" },
        "proof": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "const": "Ed25519Signature2018" }
          }
        }
      }
    },
    "EventHash": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$",
      "description": "Must equal the bytes32 emitted by ComplianceVerifier.recordEvent() for the same event (FR-004)."
    },
    "ComplianceStatus": {
      "type": "string",
      "enum": ["compliant", "superseded"],
      "description": "Issued VCs are `compliant`; corrections are issued as a new VC with `superseded` referencing the prior via `supersedes` (spec §FR-014). Non-compliant events are rejected upstream and never produce a VC."
    },
    "GuaranteedMetadata": {
      "type": "object",
      "required": ["eventHash", "complianceStatus", "policyVersion", "issuedAt"],
      "properties": {
        "eventHash": { "$ref": "#/$defs/EventHash" },
        "complianceStatus": { "$ref": "#/$defs/ComplianceStatus" },
        "policyVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Semver of the Guardian policy that issued this VC (spec §FR-012)."
        },
        "issuedAt": { "type": "string", "format": "date-time" },
        "supersedes": {
          "$ref": "#/$defs/EventHash",
          "description": "Required when complianceStatus = 'superseded'; points at the prior VC's eventHash. Absent on the original compliant VC (spec §FR-014)."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "complianceStatus": { "const": "superseded" } } },
          "then": { "required": ["supersedes"] }
        }
      ]
    },
    "GDSTComplianceCredential": {
      "allOf": [
        { "$ref": "#/$defs/BaseVC" },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "array",
              "contains": { "const": "GDSTComplianceCredential" }
            },
            "credentialSubject": {
              "description": "Embeds the full submitted GDST event payload verbatim (spec §FR-015) plus the Guaranteed metadata fields. `additionalProperties: true` is intentional — all KDEs present on the source event MUST flow through unredacted.",
              "allOf": [
                { "$ref": "#/$defs/GuaranteedMetadata" },
                {
                  "type": "object",
                  "required": ["gdstEventType", "species"],
                  "properties": {
                    "gdstEventType": {
                      "type": "string",
                      "enum": [
                        "Fishing",
                        "Landing",
                        "Transshipment",
                        "OnVesselProcessing",
                        "Processing",
                        "Shipping",
                        "Aggregation"
                      ]
                    },
                    "species": { "type": "string", "pattern": "^[A-Z]{3}$" },
                    "catchArea": { "type": "string", "pattern": "^FAO\\d{2,3}$" },
                    "fishingAuthorization": { "type": "string" },
                    "landingAuthorization": { "type": "string" },
                    "transshipmentAuthorization": { "type": "string" },
                    "vesselId": { "type": "string" }
                  },
                  "additionalProperties": true
                }
              ]
            }
          }
        }
      ]
    },
    "FSMA204ComplianceCredential": {
      "allOf": [
        { "$ref": "#/$defs/BaseVC" },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "array",
              "contains": { "const": "FSMA204ComplianceCredential" }
            },
            "credentialSubject": {
              "description": "Embeds the full submitted FSMA event payload verbatim (spec §FR-015) plus the Guaranteed metadata fields. `additionalProperties: true` is intentional — all KDEs present on the source event MUST flow through unredacted.",
              "allOf": [
                { "$ref": "#/$defs/GuaranteedMetadata" },
                {
                  "type": "object",
                  "required": ["fsma204EventType"],
                  "properties": {
                    "fsma204EventType": {
                      "type": "string",
                      "enum": [
                        "creating",
                        "shipping",
                        "receiving",
                        "transforming",
                        "packing",
                        "unpacking"
                      ]
                    },
                    "facility": { "type": "string" },
                    "shipFrom": { "type": "string" },
                    "shipTo": { "type": "string" }
                  },
                  "additionalProperties": true
                }
              ]
            }
          }
        }
      ]
    }
  }
}
